# ============================================
# NPTA Environment Variables
# ============================================

# Server
NODE_ENV=development
PORT=3001
SESSION_SECRET=change-this-to-a-random-secret

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/npta?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/npta?schema=public"

# CORS
CORS_ORIGIN=http://localhost:5173

# Client (Vite - prefix with VITE_)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001
