{
  "name": "@npta/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx prisma generate && tsc && tsc-alias",
    "start": "node dist/index.js",
    "test": "npx tsx --test src/__tests__/engine.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@npta/shared": "*",
    "@prisma/client": "^6.9.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "nanoid": "^5.1.5",
    "socket.io": "^4.8.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/socket.io": "^3.0.1",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.9.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
